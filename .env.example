# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use embedded PGlite (persisted in ./.pglite).
#
# Local Supabase (npm run db:start, requires Docker Desktop):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Hosted Supabase (later). Copy the string from Project Settings > Database.
#   Direct / session pooler (port 5432):
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Transaction pooler (port 6543, use for serverless, e.g. Vercel). Prepared
#   statements are NOT supported there; the client disables them automatically
#   when the URL uses port 6543 (postgres-js option prepare: false).
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Run migrations (npm run db:migrate) against the direct/session string.

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- Seed -------------------------------------------------------------------
# Password for the admin user "rocio" created by `npm run db:seed`.
# Required by the seed script; there is no default.
SEED_ADMIN_PASSWORD=
