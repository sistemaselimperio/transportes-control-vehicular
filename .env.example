# --- Database (Neon) --------------------------------------------------------
# Pooled connection string, used by the app.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Direct connection string, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- Seed -------------------------------------------------------------------
# Password for the admin user "rocio" created by `npm run db:seed`.
# Required by the seed script; there is no default.
SEED_ADMIN_PASSWORD=
